{
	"name": "sftools-frontend",
	"version": "0.0.0",
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"build": "ng build",
		"watch": "ng build --watch --configuration development",
		"test": "node --import ./tests/register-typescript.mjs --test tests/*.test.mjs",
		"test:security": "node --import ./tests/register-typescript.mjs --test tests/security.test.mjs",
		"test:satisfactory": "node --import ./tests/register-typescript.mjs --test tests/satisfactory-mode.test.mjs",
		"test:performance": "node --import ./tests/register-typescript.mjs --test tests/performance-regressions.test.mjs",
		"benchmark:performance": "node --expose-gc --import ./tests/register-typescript.mjs tests/performance-benchmark.mjs"
	},
	"private": true,
	"license": "MIT",
	"dependencies": {
		"@angular/animations": "^22.2.3",
		"@angular/common": "^22.2.3",
		"@angular/compiler": "^22.2.3",
		"@angular/core": "^22.2.3",
		"@angular/forms": "^22.2.3",
		"@angular/platform-browser": "^22.2.3",
		"@angular/router": "^22.2.3",
		"@antv/x6": "^3.1.7",
		"@etothepii/satisfactory-file-parser": "^4.1.1",
		"@fontsource/lato": "^5.3.0",
		"@fortawesome/angular-fontawesome": "^5.0.0",
		"@fortawesome/fontawesome-svg-core": "^7.2.0",
		"@fortawesome/free-regular-svg-icons": "^7.2.0",
		"@fortawesome/free-solid-svg-icons": "^7.2.0",
		"bootstrap": "^5.3.8",
		"dompurify": "^3.4.17",
		"elkjs": "^0.11.1",
		"highs": "^1.14.2",
		"marked": "^18.0.13",
		"ngx-bootstrap": "^22.0.0",
		"rxjs": "^7.8.2",
		"tslib": "^2.8.1",
		"zone.js": "^0.16.2"
	},
	"devDependencies": {
		"@angular/build": "^22.2.4",
		"@angular/cli": "~22.2.4",
		"@angular/compiler-cli": "^22.2.3",
		"jsdom": "^30.1.3",
		"sass": "^1.101.0",
		"typescript": "~6.0.3"
	},
	"overrides": {
		"vite": "^8.3.5"
	},
	"engines": {
		"node": "^22.23.4 || ^24.22.1 || >=26.12.1"
	}
}
