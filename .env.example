# Token for this app's remotely managed Cloudflare Tunnel.
# Configure satisfactory.bitstacker.dev -> http://caddy:80 in its published routes.
CLOUDFLARE_TUNNEL_TOKEN=

# Shared plan-library password. Use the same password on every device; at least 12 characters.
SFTOOLS_PASSWORD=
# Local Docker only: set this if using a different localhost port. Production uses the public HTTPS origin.
# SFTOOLS_ORIGIN=http://localhost:8080
